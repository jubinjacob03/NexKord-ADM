{
  "name": "nexkord-adm",
  "version": "1.0.0",
  "private": true,
  "description": "NexKord-ADM: Central Game Management Discord Bot",
  "main": "src/index.js",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "deploy": "node src/deploy-commands.js",
    "build": "npm run lint",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "selfbot": "node src/selfbot/index.js",
    "selfbot:dev": "node --watch src/selfbot/index.js",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "token:grab": "node scripts/token-grabber.js",
    "test:akinator:local": "node scripts/test-akinator-local.mjs",
    "icons:cinema": "node scripts/generate-cinema-icons.mjs"
  },
  "dependencies": {
    "@dank074/discord-video-stream": "6.0.0",
    "cycletls": "1.0.27",
    "discord.js": "14.27.0",
    "discord.js-selfbot-v13": "3.7.1",
    "dotenv": "16.6.1",
    "form-data": "4.0.6",
    "puppeteer": "25.9.0"
  },
  "overrides": {
    "node-av": "5.2.3",
    "sharp": "0.35.3",
    "js-yaml": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "werift": {
      "ip": "npm:neoip@2.1.0"
    },
    "werift-ice": {
      "ip": "npm:neoip@2.1.0"
    }
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "nodemon": "3.1.14",
    "sharp": "0.35.3"
  }
}
