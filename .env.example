# =============================================================================
# NexKord-ADM environment configuration
# Copy this file to .env, replace placeholders, and enable only the subsystems
# you use. Commented values show built-in defaults or example overrides.
# =============================================================================

# -----------------------------------------------------------------------------
# Main bot
# -----------------------------------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id_here
GUILD_ID=your_primary_guild_id_here

# -----------------------------------------------------------------------------
# Akinator
# -----------------------------------------------------------------------------
AKINATOR_CHANNEL_ID=your_channel_id_here
# AKINATOR_PROXY=
# AKINATOR_REQUEST_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Cinema dashboard, public board, authorization, and downloads
# -----------------------------------------------------------------------------
TMDB_API_KEY=your_tmdb_api_key_here
CINEMA_DASHBOARD_CHANNEL_ID=your_channel_id_here
# CINEMA_GUILD_ID=your_guild_id_here
# CINEMA_ANNOUNCEMENT_CHANNEL_ID=your_channel_id_here
# CINEMA_SHOWTIMES_CHANNEL_ID=your_channel_id_here
# CINEMA_MODERATOR_USER_IDS=123456789012345678,234567890123456789
# CINEMA_MODERATOR_ROLE_IDS=345678901234567890,456789012345678901
# CINEMA_DOWNLOAD_ALLOWED_HOSTS=cdn.example.com,drive.google.com
# CINEMA_DOWNLOAD_TIMEOUT_MS=3600000
# CINEMA_MAX_DOWNLOAD_MB=20480

# Screens map dashboard actions to the text channels watched by selfbots.
# Define up to 10 screens. Scanning stops at the first screen without a name.
CINEMA_SCREEN_1_NAME=Screen 1
CINEMA_SCREEN_1_CHANNEL_ID=your_channel_id_here
CINEMA_SCREEN_1_VOICE_CHANNEL_ID=your_voice_channel_id_here
CINEMA_SCREEN_1_PREFIX=!
# CINEMA_SCREEN_2_NAME=Screen 2
# CINEMA_SCREEN_2_CHANNEL_ID=
# CINEMA_SCREEN_2_VOICE_CHANNEL_ID=
# CINEMA_SCREEN_2_PREFIX=!

# =============================================================================
# Streaming selfbot: separate process started with npm run selfbot
# Automating a Discord user account violates Discord's Terms of Service and can
# result in account termination. Use it only if you accept that risk.
# =============================================================================

SELFBOT_TOKEN=your_user_token_here
SELFBOT_GUILD_ID=your_guild_id_here
SELFBOT_CHANNEL_ID=your_channel_id_here
SELFBOT_VOICE_CHANNEL_ID=your_voice_channel_id_here
# SELFBOT_CONTROLLER_ID=your_main_bot_user_id_here
# SELFBOT_OPERATOR_IDS=123456789012345678,234567890123456789
# SELFBOT_PLAY_ALLOWED_HOSTS=cdn.example.com,media.example.net
# SELFBOT_STAY_IN_VC=true
# SELFBOT_VC_KEEPALIVE_MS=30000
# SELFBOT_TOKEN_VALIDATION_TIMEOUT_MS=10000
# SELFBOT_PREFIX=!
# SELFBOT_SERVER_INDEX=0

# -----------------------------------------------------------------------------
# Browser extraction and process controls
# -----------------------------------------------------------------------------
# CHROMIUM_PATH=
# PUPPETEER_EXECUTABLE_PATH=
# ALLOW_MULTIPLE_INSTANCES=false
# DEBUG_LEVEL=warn

# -----------------------------------------------------------------------------
# Selfbot timeouts in milliseconds
# -----------------------------------------------------------------------------
# EXTRACTOR_TIMEOUT_MS=25000
# STREAM_STARTUP_TIMEOUT_MS=60000
# SOURCE_READ_TIMEOUT_MS=30000
# SOURCE_DOWNLOAD_TIMEOUT_MS=3600000
# SOURCE_MAX_MB=20480
# PROBE_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Remote stream encoding in kbps unless noted
# -----------------------------------------------------------------------------
# STREAM_MAX_WIDTH=2560
# STREAM_MAX_FPS=60
# STREAM_FORCE_WIDTH=0
# STREAM_FORCE_FPS=0
# STREAM_BITRATE=0
# STREAM_BITRATE_FLOOR=4000
# STREAM_BITRATE_MAX=4000
# STREAM_BITRATE_AUDIO=192
# STREAM_PRESET=veryfast
# STREAM_CODEC=H264
# STREAM_HWACCEL=true

# -----------------------------------------------------------------------------
# Local-cache stream encoding
# -----------------------------------------------------------------------------
# LOCAL_STREAM_PROFILE=true
# LOCAL_STREAM_SKIP_PROBE=true
# LOCAL_STREAM_STARTUP_TIMEOUT_MS=10000
# LOCAL_STREAM_PROBE_TIMEOUT_MS=3000
# LOCAL_STREAM_BITRATE=12000
# LOCAL_STREAM_BITRATE_FLOOR=8000
# LOCAL_STREAM_BITRATE_MAX=16000
# LOCAL_STREAM_BITRATE_AUDIO=256
# LOCAL_STREAM_PRESET=ultrafast

# -----------------------------------------------------------------------------
# Prefetch cache
# -----------------------------------------------------------------------------
# PREFETCH=true
# PREFETCH_PRESET=veryfast
# PREFETCH_CACHE_GB=80
# PREFETCH_BITRATE_FACTOR=2.5
# PREFETCH_CRF=18
# PREFETCH_MAXRATE=12000
# PREFETCH_LIMIT_SECONDS=0
# PREFETCH_MIN_DURATION_SECONDS=60
# PREFETCH_MAX_CONCURRENT=1
