DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_primary_guild_id_here

# Akinator Minigame
AKINATOR_CHANNEL_ID=your_channel_id_here
# Optional proxy for non-datacenter egress, useful when Cloudflare blocks VPS IPs.
# Examples: http://host:port | socks5://host:port
# AKINATOR_PROXY=
# AKINATOR_PROXY_USER=
# AKINATOR_PROXY_PASS=
# AKINATOR_REQUEST_TIMEOUT_MS=15000

# Cinema (Movie Theater)
CINEMA_DASHBOARD_CHANNEL_ID=your_channel_id_here
CINEMA_SELFBOT_CHANNEL_ID=your_channel_id_here
CINEMA_SELFBOT_PREFIX=!
CINEMA_VOICE_CHANNEL_ID=
