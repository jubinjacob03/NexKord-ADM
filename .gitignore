# Node modules and package manager noise
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.node_repl_history
*.tgz
.eslintcache

# Environment variables and credential material
.env*
!.env.example
.npmrc
secrets/
*.secret
*.pem
*.key
*.p12
*.pfx

# Backups of secret-bearing files
*.bak

# Runtime state, media, browser profiles, caches, and spools
data/

# Stray runtime artifacts if a process runs outside the data directory
*.part
*.corrupt-*
*.tmp
tmp/
temp/
instance.lock

# Large media must never be committed from the repository root
/*.mkv
/*.mp4
/*.webm
/*.avi
/*.mov
/*.flv

# Generated asset directories. assets/akinator is tracked and read at runtime,
# so only the generated subtrees are ignored.
assets/emoji-backup/
assets/server-emojis/
assets/cinema/

# Generated review and analysis output
semantic-review/

# Untracked sibling project
new-idea/

# Puppeteer and Chromium downloads
.local-chromium/
.cache/

# Build output
dist/
build/

# IDEs and OS files
.vscode/
.idea/
.vs/
*.swp
*.swo
*~
*.sublime-workspace
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs
logs/
*.log

# Test and coverage output
coverage/
.nyc_output/
test-*.output
