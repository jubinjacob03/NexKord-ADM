DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_primary_guild_id_here

# Pterodactyl Panel Settings
PTERODACTYL_URL=https://panel.freegamehost.xyz
PTERODACTYL_SERVER_ID=your_server_id_here
PTERODACTYL_API_KEY=your_client_api_key_here
MINECRAFT_DASHBOARD_CHANNEL_ID=your_channel_id_here

# FreeGameHost Auto-Renewal
FREEGAMEHOST_SERVER_UUID=ed04584b
FGH_EMAIL=your_panel_email@gmail.com
FGH_PASSWORD=your_panel_password

# Akinator Minigame
# Text channel where the Akinator chatbot runs. Anyone chatting here starts/plays a game.
AKINATOR_CHANNEL_ID=your_channel_id_here
# Akinator's Cloudflare blocks datacenter IPs (403). On a VPS you MUST route the
# game's browser through a non-datacenter proxy (residential / mobile / WARP).
# Examples: http://host:port  |  socks5://host:port  |  socks5://warp:1080
# AKINATOR_PROXY=
# AKINATOR_PROXY_USER=
# AKINATOR_PROXY_PASS=

# Among Us Custom Server (Impostor)
IMPOSTOR_SERVER_IP=your_vps_public_ip_here
IMPOSTOR_API_URL=http://impostor:22025
IMPOSTOR_API_KEY=your_secret_api_key_here
AMONGUS_DASHBOARD_CHANNEL_ID=your_channel_id_here

# Among Us Dead-Player Voice Enforcement
# Voice channel where push-to-talk is enforced on killed/ejected players.
AMONGUS_GAME_VC_ID=your_voice_channel_id_here
# Internal port the bot listens on for game events pushed by the Impostor plugin.
BOT_EVENT_PORT=22026
# URL the Impostor plugin POSTs game events to (docker-network address of the bot).
BOT_EVENT_URL=http://nexkord-adm:22026/events
